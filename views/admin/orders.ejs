<%- include('../partials/header') %>

<h1 class="page-title">订单管理</h1>

<div class="admin-nav">
  <a href="/admin">仪表盘</a>
  <a href="/admin/products">商品管理</a>
  <a href="/admin/orders" class="active">订单管理</a>
  <a href="/admin/users">用户管理</a>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>订单号</th><th>收货人</th><th>金额</th><th>下单时间</th><th>状态</th><th>操作</th></tr>
    </thead>
    <tbody>
      <% orders.forEach(function(o){ %>
        <tr>
          <td><code><%= o.id %></code></td>
          <td><%= o.receiver %></td>
          <td><span class="price"><%= fmt(o.total) %></span></td>
          <td><%= new Date(o.createdAt).toLocaleString('zh-CN') %></td>
          <td>
            <span class="badge <%= o.status === '待发货' ? 'badge-pending' : o.status === '已发货' ? 'badge-shipped' : 'badge-done' %>"><%= o.status %></span>
          </td>
          <td style="white-space:nowrap;">
            <form action="/admin/orders/<%= o.id %>/status" method="POST" style="display:inline-flex;gap:6px;">
              <select name="status" class="select" style="padding:6px 10px;">
                <option value="待发货" <%= o.status === '待发货' ? 'selected' : '' %>>待发货</option>
                <option value="已发货" <%= o.status === '已发货' ? 'selected' : '' %>>已发货</option>
                <option value="已完成" <%= o.status === '已完成' ? 'selected' : '' %>>已完成</option>
              </select>
              <button class="btn btn-outline btn-sm" type="submit">更新</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
