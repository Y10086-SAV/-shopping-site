<%- include('../partials/header') %>

<h1 class="page-title">用户管理</h1>

<div class="admin-nav">
  <a href="/admin">仪表盘</a>
  <a href="/admin/products">商品管理</a>
  <a href="/admin/orders">订单管理</a>
  <a href="/admin/users" class="active">用户管理</a>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>ID</th><th>用户名</th><th>邮箱</th><th>角色</th><th>注册时间</th></tr>
    </thead>
    <tbody>
      <% users.forEach(function(u){ %>
        <tr>
          <td><code><%= u.id %></code></td>
          <td><%= u.username %></td>
          <td><%= u.email %></td>
          <td><span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-customer' %>"><%= u.role === 'admin' ? '管理员' : '顾客' %></span></td>
          <td><%= new Date(u.createdAt).toLocaleString('zh-CN') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
