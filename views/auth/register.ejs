<%- include('../partials/header') %>

<div class="form-card">
  <h2>注册</h2>
  <form action="/register" method="POST">
    <div class="form-group">
      <label>用户名</label>
      <input type="text" name="username" value="<%= form.username || '' %>" required />
      <% if (errors.username) { %><div class="form-error"><%= errors.username %></div><% } %>
    </div>
    <div class="form-group">
      <label>邮箱</label>
      <input type="email" name="email" value="<%= form.email || '' %>" required />
      <% if (errors.email) { %><div class="form-error"><%= errors.email %></div><% } %>
    </div>
    <div class="form-group">
      <label>密码</label>
      <input type="password" name="password" required />
      <% if (errors.password) { %><div class="form-error"><%= errors.password %></div><% } %>
    </div>
    <div class="form-group">
      <label>确认密码</label>
      <input type="password" name="confirm" required />
      <% if (errors.confirm) { %><div class="form-error"><%= errors.confirm %></div><% } %>
    </div>
    <button class="btn btn-primary" type="submit" style="width:100%;">注册</button>
  </form>
  <div class="form-footer">已有账号？<a href="/login">去登录</a></div>
</div>

<%- include('../partials/footer') %>
