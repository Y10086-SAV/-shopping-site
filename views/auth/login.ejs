<%- include('../partials/header') %>

<div class="form-card">
  <h2>登录</h2>
  <% if (error) { %>
    <div class="flash flash-danger"><%= error %></div>
  <% } %>
  <form action="/login" method="POST">
    <div class="form-group">
      <label>用户名</label>
      <input type="text" name="username" value="<%= form.username || '' %>" required />
    </div>
    <div class="form-group">
      <label>密码</label>
      <input type="password" name="password" required />
    </div>
    <button class="btn btn-primary" type="submit" style="width:100%;">登录</button>
  </form>
  <div class="form-footer">还没有账号？<a href="/register">立即注册</a></div>
</div>

<%- include('../partials/footer') %>
