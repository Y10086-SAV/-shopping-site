<%- include('../partials/header') %>

<div class="detail-wrap" style="margin-top:28px;">
  <div class="detail-image">
    <img src="<%= product.image %>" alt="<%= product.name %>" />
  </div>
  <div class="detail-info">
    <span class="meta"><%= product.category %></span>
    <h1><%= product.name %></h1>
    <div class="detail-price"><%= fmt(product.price) %></div>
    <p class="detail-desc"><%= product.description %></p>
    <div class="stock">库存：<%= product.stock %> 件</div>

    <form action="/cart/add" method="POST">
      <input type="hidden" name="productId" value="<%= product.id %>" />
      <div class="qty-box">
        <label>数量</label>
        <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" />
      </div>
      <button class="btn btn-primary" type="submit" <%= product.stock < 1 ? 'disabled' : '' %>>
        <%= product.stock < 1 ? '已售罄' : '加入购物车' %>
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
