<%- include('../partials/header') %>

<h1 class="page-title">我的订单</h1>

<% if (orders.length === 0) { %>
  <div class="empty"><div class="icon">📋</div>暂无订单</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>订单号</th><th>下单时间</th><th>金额</th><th>状态</th><th></th></tr>
    </thead>
    <tbody>
      <% orders.forEach(function(o){ %>
        <tr>
          <td><code><%= o.id %></code></td>
          <td><%= new Date(o.createdAt).toLocaleString('zh-CN') %></td>
          <td><span class="price"><%= fmt(o.total) %></span></td>
          <td>
            <span class="badge <%= o.status === '待发货' ? 'badge-pending' : o.status === '已发货' ? 'badge-shipped' : 'badge-done' %>"><%= o.status %></span>
          </td>
          <td><a href="/orders/<%= o.id %>" class="btn btn-outline btn-sm">查看</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('../partials/footer') %>
